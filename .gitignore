# build / dev artifacts
preview*.png
preview*.pdf
render/
*.pyc
__pycache__/
.DS_Store
voice/voice.json
voice/*.mp3
voice/*.wav
*.env

# iOS app: the bundled web build is generated (npm run build), and node_modules
# and the CocoaPods checkout come from the toolchain
ios/www/
node_modules/
ios/App/Pods/

# generated by xcodegen from ios/project.yml
ios/Prayers.xcodeproj/
ios/App/Info.plist

# credentials — never commit these. App Store Connect API keys belong in
# ~/.appstoreconnect/private_keys/, where xcodebuild and altool look for them.
*.p8
*.cer
*.p12
*.mobileprovision
