# The generated prayer pages. These are an intermediate step on the way to
# ios/Content/content.json, not a deliverable — nothing is served anywhere, so
# only the content model is committed. Rebuild with `python3 build.py`.
build/

# build / dev artifacts
preview*.png
preview*.pdf
render/
*.pyc
__pycache__/
.DS_Store
*.env

# generated by xcodegen from ios/project.yml
ios/Prayers.xcodeproj/
ios/App/Info.plist

# credentials — never commit these. App Store Connect API keys belong in
# ~/.appstoreconnect/private_keys/, where xcodebuild and altool look for them.
*.p8
*.cer
*.p12
*.mobileprovision

# worship recordings — other people's published work. Bundled into the app
# for personal use, deliberately never committed: this repository is public.
hymns/
ios/Music/
