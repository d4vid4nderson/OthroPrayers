# The generated prayer pages. These are an intermediate step on the way to
# ios/Content/content.json, not a deliverable — nothing is served anywhere, so
# only the content model is committed. Rebuild with `python3 build.py`.
build/

# build / dev artifacts
# anchored to the repo root on purpose: these are stray render artifacts from
# the web era. Unanchored, "preview*.png" also matched every
# Assets.xcassets/Preview*.imageset/preview.png, so the icon picker shipped
# with imagesets whose Contents.json pointed at a file that was never
# committed — and drew nothing.
/preview*.png
/preview*.pdf
render/
*.pyc
__pycache__/
.DS_Store
*.env

# generated by xcodegen from ios/project.yml
ios/Prayers.xcodeproj/
ios/App/Info.plist

# credentials — never commit these. App Store Connect API keys belong in
# ~/.appstoreconnect/private_keys/, where xcodebuild and altool look for them.
*.p8
*.cer
*.p12
*.mobileprovision

# worship recordings — other people's published work. Bundled into the app
# for personal use, deliberately never committed: this repository is public.
#
# The *directory* is kept (via .gitkeep) even though its contents are not:
# project.yml references Music as a folder, and Xcode's copy phase fails the
# whole build if the path does not exist. Marking the source `optional` is not
# enough — XcodeGen still writes the reference into the project.
hymns/
ios/Music/*
!ios/Music/.gitkeep
